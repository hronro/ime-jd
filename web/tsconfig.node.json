{
  // Build/test tooling and the tests themselves run in Node (Vitest also
  // loads src/ modules there, so those are re-checked with Node's globals).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src/env.d.ts", "test", "vite.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
