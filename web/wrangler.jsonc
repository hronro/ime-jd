// Cloudflare Workers static assets: the built PWA in ./dist, no server code.
//   production — ime-jd-web.hronro.com, deployed by .github/workflows/release.yml on a tag
//   preview    — ime-jd-web-preview.hronro.com, deployed by build-on-push.yml on master
// Both need CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID (repo secrets).
// By hand: `npm run build && npx wrangler deploy [--env preview]`.
{
  "name": "ime-jd-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "ime-jd-web.hronro.com", "custom_domain": true }],
  "env": {
    "preview": {
      "name": "ime-jd-web-preview",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "routes": [{ "pattern": "ime-jd-web-preview.hronro.com", "custom_domain": true }]
    }
  }
}
