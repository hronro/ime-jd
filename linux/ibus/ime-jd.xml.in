<?xml version="1.0" encoding="utf-8"?>
<component>
	<name>io.github.hronro.ImeJd</name>
	<description>键道输入法</description>
	<exec>@EXEC@ --ibus</exec>
	<version>@VERSION@</version>
	<author>hronro</author>
	<license>GPL-3.0</license>
	<homepage>https://github.com/hronro/ime-jd</homepage>
