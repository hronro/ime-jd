	<engines>
		<engine>
			<name>ime-jd</name>
			<language>zh_CN</language>
			<license>GPL-3.0</license>
			<author>hronro</author>
			<icon>@ICON@</icon>
			<layout>default</layout>
			<longname>键道</longname>
			<description>键道输入法</description>
			<rank>0</rank>
			<symbol>中</symbol>
			<icon_prop_key>InputMode</icon_prop_key>
		</engine>
	</engines>
